# Somente para execução local. No ambiente de nuvem, use as configurações de segredos.
PORT=3000
# Ative somente após configurar a Routes API, a chave e as cotas no Google.
GOOGLE_ROUTES_ENABLED=false
# Configure a chave em .env local ou no campo seguro Environment do Render, nunca no GitHub.
GOOGLE_MAPS_API_KEY=
# Limite diário de tentativas neste aplicativo (dia em America/Bahia). 0 bloqueia consultas.
ROUTES_DAILY_LIMIT=0
